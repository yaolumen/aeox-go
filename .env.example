# AEOX Store 环境变量
# 部署时复制为 .env，或通过主机面板注入环境变量
# 未设置的变量系统会自动生成并持久化到 data/ 目录，重启后仍有效

# ===== 必设 =====
ADMIN_PASSWORD=change-me-to-strong-password

# ===== 可选（未设置时自动生成） =====
# PORT=3000
# BASE_URL=https://go.aeox.uk
# ADMIN_ENTRY_KEY=
# JWT_SECRET=
# DOWNLOAD_TOKEN_SECRET=
# DOWNLOAD_TOKEN_TTL=86400

# ===== V1 API CORS（默认允许所有域） =====
# CORS_ORIGINS=*

# ===== Stripe（后期付费书籍时配置） =====
# STRIPE_SECRET_KEY=
# STRIPE_MODE=test
